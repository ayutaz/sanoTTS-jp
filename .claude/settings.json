{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(~/Documents/piper-plus/**)",
      "Write(~/Documents/piper-plus/**)"
    ],
    "allow": [
      "Bash(uv run:*)",
      "Bash(uv sync)",
      "Bash(uv lock)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"",
            "timeout": 10,
            "statusMessage": "プロジェクト制約を確認中"
          }
        ]
      }
    ]
  }
}
