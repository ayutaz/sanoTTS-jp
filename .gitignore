# 教師ラベルパック・コーパス・合成音声。
# 23,271 行分の (dT, zT, yT) は数 GB になるのでコミットしない。
# コーパス本文は再配布しない (JSUT / Common Voice / ROHAN のライセンス)。
# data/splits/ は build_corpus.py で再生成できる。
/data/
/labels/

# reports/ は B-0 等の一次データ (JSON、数百 KB) なので追跡する
*.wav
*.npz
*.ckpt
*.onnx

# 枝刈り辞書のビルド成果物 (B-0)
/dict_build/

# Python / uv
# uv.lock は再現性のためコミットする（除外しない）
*.egg-info/
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store
