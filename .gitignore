# 教師ラベルパック・コーパス・合成音声。
# 23,271 行分の (dT, zT, yT) は数 GB になるのでコミットしない。
# コーパス本文は再配布しない (JSUT / Common Voice / ROHAN のライセンス)。
# scripts/b0/build_corpus.py で再生成できる。
/data/*
!/data/splits/
/data/splits/*
# 手書きの独自資産とメタデータだけは追跡する
!/data/splits/corpus_embedded.tsv
!/data/splits/corpus_stats.json
!/data/splits/corpus_charstats.json
# 除外 uid のリスト（本文は含めない）。再現に要るので追跡する
!/data/splits/exclusions_*.txt
# アクセント型ミニマルペアの評価セット（D-030）。自作の 32 語 + テンプレート 2 本で
# コーパス本文を含まない。**凍結物なので追跡する**
!/data/splits/accent_pairs.tsv
/labels/

# reports/ は B-0 等の一次データ (JSON、数百 KB) なので追跡する。
# ただし **全コーパス行のダンプは追跡しない**（本文の再配布になる）
/reports/durations/
*.wav
/reports/b5_teacher_wav/
*.npz
*.ckpt
*.onnx

# 枝刈り辞書のビルド成果物 (B-0)
/dict_build/

# Python / uv
# uv.lock は再現性のためコミットする（除外しない）
*.egg-info/
__pycache__/
*.py[cod]
.venv/
# CI と CONTRIBUTING が作る使い捨ての venv（`uv venv --python 3.12 .venv-ci`）
.venv-*/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store

# 個人設定（許可モード等）。チームで共有しない
.claude/settings.local.json

# 学習の成果物。重みは数 MB だが、ログと一緒に runs/ ごと除外する
# （再現に要るのは summary.json と log.jsonl だけなので、必要になったら個別に追跡する）
/runs/*/stage*.pt
# 合成音声
/reports/eval_*/
/reports/student_wav/
/reports/_fake_idf/
/reports/esp32_hoststub/

# C コアのビルド成果物とエクスポート（再生成できる）
/csrc/golden_test
/csrc/*.bin
/csrc/*.o
/csrc/student_i8.bin

# --- OSS 公開のための除外 ---
# ビルド成果物（`make -C csrc` で再生成できる）
/csrc/bench
/csrc/fft_test
/csrc/int8_test
/csrc/int8_e2e_test
/csrc/stream_test
/csrc/arena_stress
/csrc/g2p_test
/csrc/line_test
/csrc/dump_pcm_a32
/csrc/dump_pcm_a8
/csrc/int8_e2e_test_a8
/csrc/prof_test

# レーン比較の生成物（`make -C csrc lanes` で再生成できる）。
# ⚠️ wav は *.wav で既に除外されるが、**ディレクトリごと**明示しておく。
# ただし **測定結果の JSON は残す**（M-55 の一次記録）
/reports/lanes/*
!/reports/lanes/scoreq.json
# モデルの重み。⚠️ 教師コーパスのライセンス継承の議論があるので配布しない
/reports/**/*.pt

# ESP-IDF のビルド成果物（実機作業で数百 MB になる）
esp32/build/
/reports/e1_dnsmos/scratch/
# ⚠️ 上流 (GPL-3.0) のドキュメントを**丸ごと複製しない**（D-032）。
# 事実（数値・構成）の参照は可だが、文章そのものは MIT リポジトリに置けない。
# 得た事実は docs/upstream-sanotts.md に自分の言葉で要約すること。
reports/r3_upstream_*.md
reports/upstream_*.md

# 調査で取得したサードパーティの成果物（配布物なので追跡しない）
reports/**/*.pdf
reports/**/*.whl
reports/r1_dnsmos/          # 論文 PDF の作業ディレクトリ。出典は docs 側に書く
reports/verify_e2/          # 敵対的検証のスクラッチ
reports/e1_dnsmos/scratch/

# ESP-IDF のビルド成果物
/esp32/build/
/esp32/pie_probe/build/
/esp32/**/sdkconfig
/esp32/**/sdkconfig.old
/esp32/.cache/
/reports/listening/

# リリース検証用の一時比較ディレクトリ（eval_* への symlink を含む）
/reports/dnsmos_v2v3/

# ESP-IDF のビルドディレクトリ（複数構成を並べる）
/esp32/build_*/

# K-1 の中間生成物（entries.tsv 90 MB / trie キャッシュ 54 MB）
.k1work/

# K-2 の検証ベクタ（blob 込みで数 MB。make -C csrc k2 が生成する）
csrc/k2_vectors.bin
csrc/k2_test
csrc/k4_vectors.bin
csrc/k4_test

# K-4b / K-5 の生成物（`make -C csrc k4b` / `k5` で再生成できる）
csrc/k4b_test
csrc/k4b_stderr.log
csrc/k5_mem_test
csrc/k5_mem_ctrl
csrc/k5_stderr.log
csrc/k5_ctrl/
# ⚠️ ラベルはコーパス由来の派生物なので**コミットしない**（数 MB あるのに加えて、
#    フルコンテキストラベルは元の文をかなり復元できる）
csrc/k5_labels*.txt
csrc/openjtalk/*.o
csrc/k6_test
csrc/k6_stderr.log
csrc/k7_test
csrc/k7_stderr.log

# K-7 のビルド出力
esp32/build_kanji/
esp32/build_nokanji/
csrc/k1_dict.bin
csrc/k6_vectors.bin

# K-8 の聴取セット（コーパス由来の音声。**生成物は配布しない**方針に合わせて追跡しない）
#   uv run --extra eval python scripts/k1/k8_audio_gap.py --ids ... --wav-dir reports/k8_listen
/reports/k8_listen/
