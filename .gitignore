# 教師ラベルパック・コーパス・合成音声。
# 23,271 行分の (dT, zT, yT) は数 GB になるのでコミットしない。
# コーパス本文は再配布しない (JSUT / Common Voice / ROHAN のライセンス)。
# scripts/b0/build_corpus.py で再生成できる。
/data/*
!/data/splits/
/data/splits/*
# 手書きの独自資産とメタデータだけは追跡する
!/data/splits/corpus_embedded.tsv
!/data/splits/corpus_stats.json
!/data/splits/corpus_charstats.json
# 除外 uid のリスト（本文は含めない）。再現に要るので追跡する
!/data/splits/exclusions_*.txt
# アクセント型ミニマルペアの評価セット（D-030）。自作の 32 語 + テンプレート 2 本で
# コーパス本文を含まない。**凍結物なので追跡する**
!/data/splits/accent_pairs.tsv
/labels/

# reports/ は B-0 等の一次データ (JSON、数百 KB) なので追跡する。
# ただし **全コーパス行のダンプは追跡しない**（本文の再配布になる）
/reports/durations/
*.wav
/reports/b5_teacher_wav/
*.npz
*.ckpt
*.onnx

# 枝刈り辞書のビルド成果物 (B-0)
/dict_build/

# Python / uv
# uv.lock は再現性のためコミットする（除外しない）
*.egg-info/
__pycache__/
*.py[cod]
.venv/
# CI と CONTRIBUTING が作る使い捨ての venv（`uv venv --python 3.12 .venv-ci`）
.venv-*/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store

# 個人設定（許可モード等）。チームで共有しない
.claude/settings.local.json

# セッションの作業用ディレクトリ（Claude Code が作る）。**成果物ではない**
#   .claude/worktrees/ … 並行タスク用の git worktree（作業後に git worktree remove する）
#   .workflows/        … 一回限りのオーケストレーション用スクリプト。
#                        ⚠️ かつて .workflows/phase-a.js を追跡していたが、Phase A（2026-08-27）
#                        限りの道具で、どの文書からも参照されず中身も D-013 / M-16 の頃で
#                        止まっていたので外した。**結論は docs/decisions.md に残っている**
.claude/worktrees/
/.workflows/

# 学習の成果物。重みは数 MB だが、ログと一緒に runs/ ごと除外する
# （再現に要るのは summary.json と log.jsonl だけなので、必要になったら個別に追跡する）
/runs/*/stage*.pt
# 合成音声
/reports/eval_*/
/reports/student_wav/
/reports/_fake_idf/
/reports/esp32_hoststub/

# C コアのビルド成果物とエクスポート（再生成できる）
/csrc/golden_test
/csrc/*.bin
/csrc/*.o
/csrc/student_i8.bin

# --- OSS 公開のための除外 ---
# ビルド成果物（`make -C csrc` で再生成できる）
/csrc/bench
/csrc/fft_test
/csrc/int8_test
/csrc/int8_e2e_test
/csrc/stream_test
/csrc/stream_test_a8
/csrc/arena_stress
/csrc/g2p_test
/csrc/line_test
