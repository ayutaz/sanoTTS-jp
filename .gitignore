/csrc/jdict_hard_test_weak
/csrc/erf_test
/csrc/erf_test_linear
/csrc/erf_test_clamp
/csrc/range_test

# レーン比較の生成物（`make -C csrc lanes` で再生成できる）。
# ⚠️ wav は *.wav で既に除外されるが、**ディレクトリごと**明示しておく。
# ただし **測定結果の JSON は残す**（M-55 の一次記録）
/reports/lanes/*
!/reports/lanes/scoreq.json
# モデルの重み。⚠️ 教師コーパスのライセンス継承の議論があるので配布しない
/reports/**/*.pt

# ESP-IDF のビルド成果物（実機作業で数百 MB になる）
esp32/build/
/reports/e1_dnsmos/scratch/
# ⚠️ 上流 (GPL-3.0) のドキュメントを**丸ごと複製しない**（D-032）。
# 事実（数値・構成）の参照は可だが、文章そのものは MIT リポジトリに置けない。
# 得た事実は docs/upstream-sanotts.md に自分の言葉で要約すること。
reports/r3_upstream_*.md
reports/upstream_*.md

# 調査で取得したサードパーティの成果物（配布物なので追跡しない）
reports/**/*.pdf
reports/**/*.whl
reports/r1_dnsmos/          # 論文 PDF の作業ディレクトリ。出典は docs 側に書く
reports/verify_e2/          # 敵対的検証のスクラッチ
reports/e1_dnsmos/scratch/

# ESP-IDF のビルド成果物
/esp32/build/
/esp32/pie_probe/build/
# pie_probe の複数構成（T6 の D / E 節: build_probe / build_probe_dev / build_probe_psram など）
/esp32/pie_probe/build_*/
/esp32/**/sdkconfig
/esp32/**/sdkconfig.old
/esp32/.cache/
/reports/listening/

# リリース検証用の一時比較ディレクトリ（eval_* への symlink を含む）
/reports/dnsmos_v2v3/

# ESP-IDF のビルドディレクトリ（複数構成を並べる）
/esp32/build_*/

# K-1 の中間生成物（entries.tsv 90 MB / trie キャッシュ 54 MB）
.k1work/

